# Copie para .env para mudar as opções.

# Nome do assistente. Com a escuta contínua ligada, basta dizer o nome para chamá-lo.
JARVIS_NOME_ASSISTENTE=VEKTOR
JARVIS_ESCUTA_CONTINUA=1
# Visual: tron (rosto 3D feito de bits, piso em grade, motos de luz) ou reator (anel estilo Homem de Ferro)
JARVIS_TEMA=tron
# Segundos que ele espera sua resposta depois de fazer uma pergunta (sem precisar dizer o nome)
JARVIS_ESPERA_RESPOSTA_SEGUNDOS=8

# Autonomia: total (só pede confirmação para o que destrói discos, o sistema ou pastas inteiras)
# ou confirmar (pede confirmação para apagar, mover, sobrescrever, encerrar processos e desligar)
JARVIS_AUTONOMIA=total

# Cérebro: ollama (local e gratuito) ou claude (API paga da Anthropic)
JARVIS_CEREBRO=ollama

# Ollama: modelo com suporte a ferramentas, e um modelo com visão para analisar a tela
JARVIS_OLLAMA_MODELO=qwen3:8b
JARVIS_OLLAMA_VISAO=llama3.2-vision
JARVIS_OLLAMA_URL=http://localhost:11434

# Claude: chave em console.anthropic.com (precisa de créditos). Esforço: low | medium | high.
ANTHROPIC_API_KEY=
JARVIS_MODELO=claude-opus-5-5
JARVIS_ESFORCO=low

# Atalho global para falar: aperte uma vez, fale, e ele para sozinho quando você fica em silêncio.
JARVIS_ATALHO=ctrl+alt+j

# Voz (Edge TTS). Outras vozes pt-BR: pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural
JARVIS_VOZ=pt-BR-AntonioNeural
JARVIS_VOZ_VELOCIDADE=+8%
JARVIS_VOZ_TOM=-4Hz

# Reconhecimento de voz local (faster-whisper): tiny | base | small | medium | large-v3
JARVIS_WHISPER_MODELO=small
JARVIS_WHISPER_DISPOSITIVO=cpu

# Como o Jarvis chama você (opcional). Ex.: JARVIS_TRATAMENTO=senhor
JARVIS_NOME_USUARIO=
JARVIS_TRATAMENTO=

# Microfone: segundos de silêncio para encerrar a fala; limiar 0 = automático
JARVIS_SILENCIO_SEGUNDOS=1.0
JARVIS_LIMIAR_MICROFONE=0

# Segredos para integrações: qualquer variável aqui pode ser usada como ${NOME} nas requisições e
# no dados/mcp.json, sem que o modelo veja o valor. Exemplos:
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# N8N_WEBHOOK=
